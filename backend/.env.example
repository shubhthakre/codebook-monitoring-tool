# Email alerts when a monitored service goes down (and optionally recovers).
# These can also be set from the Settings page in the UI (UI values override .env).
ALERT_ENABLED=true
ALERT_TO=you@example.com
ALERT_FROM=monitoring@example.com
ALERT_ON_RECOVERY=true
# Minimum seconds between repeated down alerts for the same monitor
ALERT_COOLDOWN_SECONDS=300

# SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Oracle Instant Client (required for 11g / thick mode).
# Leave empty to auto-pick Windows or Linux Instant Client from backend/.
# ORACLE_CLIENT_LIB_DIR=
